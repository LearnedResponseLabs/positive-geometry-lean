  "last_statement_commit": "a18aa43f17ecc9bdb5746fba34664f93d3273a43",
  "export_scope": "From the Lake package Conj43: all Lean modules (including the frozen challenge statements), the Comparator configurations, driver, axiom-report entry point, build configuration, license, and the retained coloop definition-check report. From the companion package LeanTP: the decorated-permutation adapter with its import closure, fourteen modules (definitions, proofs, frozen challenge and its scaffold), four of them its vendored port of LeanLGV (Apache-2.0, Per Alexandersson) with that port's license and port note; and the loop deletion, eight modules (definitions, proofs, the root module TPLoops, frozen challenge and its scaffold) with its Comparator configuration comparator_loops.json. All are exactly as in the tagged source commit, which is also the last commit that changed a Lean statement or proof, except the two files listed under export_edits: the build configuration gains four library entries for the LeanTP modules, and comparator_adapter.json is the adapter's entry of the LeanTP Comparator configuration. Python checkers that depend on files outside the archive and development notes are omitted.",
  "export_edits": [
    {
      "path": "lakefile.toml",
      "sha256_at_source_commit": "a99d15d31d44a5065a372af21faef6be807d113e3dc1f2b76609ca2485d8cb7a",
      "sha256_exported": "1ebca6abcad23de532e22a7d9c0cc0ce3928ae1f05e0de87ebda8eedb8eee801",
      "change": "appends the library entries LGV, TP, TPAdapter and TPLoops, so that Lake builds the modules taken from LeanTP in this tree"
    },
    {
      "path": "comparator_adapter.json",
      "derived_from": "comparator_necklace.json of LeanTP at the source commit",
      "sha256_of_source_file": "ece7219e1893a65842a0a8cce3ea23a8de1ae963783c7aed0402d7cf1f995731",
      "change": "its crossing_adapter entry, as a configuration of its own"
    }
